include README.md LICENSE CITATION.cff CHANGELOG.md THIRD_PARTY_NOTICES.md RELEASE_NOTES.md RELEASE_CHECKLIST.md
recursive-include src *.py
recursive-include configs *.json *.yaml *.yml
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests *.py
recursive-include images *.png *.svg *.json
exclude plan.md
exclude docs/outreach.md
exclude context.md
exclude roadmap.md
exclude docs/opal_next_master_plan.md
exclude tools/build_evidence_demo.py
prune tools/vendor
prune tools/external
prune web
prune data
prune results
prune releases
global-exclude __pycache__ *.py[cod]

global-exclude [pP][lL][aA][nN].[mM][dD] [oO][uU][tT][rR][eE][aA][cC][hH].[mM][dD]
global-exclude [cC][oO][nN][tT][eE][xX][tT].[mM][dD] [rR][oO][aA][dD][mM][aA][pP].[mM][dD]
recursive-include .github *.yml
prune docs/frontier/historical
exclude docs/frontier/outreach_register.json

recursive-include docs/archive *.json *.zip
