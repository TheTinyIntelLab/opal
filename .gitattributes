* text=auto
*.py text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.npz binary
*.pdf binary
*.zip binary

# Downloaded CI reports retain the bytes hashed in their provenance ledger.
results/replicated_fixed_state_v1/ci-*/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Retrospective evidence preserves bytes bound by scope and verification hashes.
results/replicated_fixed_state_v1/retrospective-combi-*/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/replicated_fixed_state_v1/retrospective-combi-*/code_snapshot/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# New public-source evidence keeps pre-access and report hash bytes.
results/replicated_fixed_state_v1/eldiaz-*/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
